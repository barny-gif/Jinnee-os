{
  "id": "shopify",
  "name": "Shopify",
  "category": "shop",
  "version": "0.2.0",
  "auth": {
    "type": "client_credentials_or_token",
    "env": [
      "SHOPIFY_STORE"
    ],
    "env_any": [
      [
        "SHOPIFY_ADMIN_TOKEN"
      ],
      [
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET"
      ]
    ],
    "store_env": "SHOPIFY_STORE"
  },
  "ops": [
    "list_orders",
    "get_order",
    "list_products",
    "get_product"
  ],
  "notes": "Read-only. Scopes: read_orders, read_products, read_inventory. Implemented in connectors/shopify/ops.py. No customer personal data leaves the connector."
}
