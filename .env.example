# Read at startup: by Docker (env_file) and by the programs themselves (core/env.py).
# A variable already set in the environment wins. Restart after editing.
# --- Jinnee core
JINNEE_NAME=Jinnee
# JINNEE_LANG=              # optional: overrides business.language in config/business.yaml (hu, en, de…)
TELEGRAM_BOT_TOKEN=
# Required: your own Telegram user ID (a number, ask @userinfobot). The bot obeys this user only
# and does not start without it.
TELEGRAM_OWNER_ID=
PACKS=general              # e.g. general,ecom
REGISTRY_URL=https://jinnee-os.com/registry/index.json
DASHBOARD_PORT=8080
# Empty = the dashboard answers on this machine only (http://localhost:8080).
# Set a password to open it from another device or behind a domain.
DASHBOARD_PASSWORD=

# --- Alerts on Telegram
QUIET_HOURS=21:00-07:00    # nothing is sent in these hours; it arrives in the morning. off = never quiet
REMIND_AFTER_DAYS=2        # one reminder a day about anything that has waited this long for your decision
STUCK_AFTER_HOURS=6        # tells you when you decided something and nothing came of it for this long
UNDO_SECONDS=120           # how long you can take a decision back before the team picks it up
JINNEE_TZ=                 # e.g. Europe/Budapest. Empty = this machine's clock (in Docker that is UTC, so set it)

# --- Connectors (only the ones you use)
BILLINGO_API_KEY=
BILLINGO_ELECTRONIC=0       # 1 = e-számla (needs that Billingo feature); 0 = a normal invoice that is sent as a PDF by e-mail
SZAMLAZZ_AGENT_KEY=
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=       # old custom app token (shpat_…), OR the two lines below
SHOPIFY_CLIENT_ID=         # Dev Dashboard app: the token is fetched and renewed automatically
SHOPIFY_CLIENT_SECRET=
GLS_CLIENT_NUMBER=
GLS_USERNAME=
GLS_PASSWORD=
GLS_PICKUP_NAME=           # your shop's name and address, where the courier collects
GLS_PICKUP_STREET=
GLS_PICKUP_HOUSE=
GLS_PICKUP_CITY=
GLS_PICKUP_ZIP=
GLS_PICKUP_PHONE=
GLS_PICKUP_EMAIL=
# GLS_WEBSHOP_ENGINE=Shopify  # MyGLS requires a webshop name; default Shopify
# GLS_API_BASE=https://api.test.mygls.hu   # test system; empty = live
# Gmail, several accounts (connectors/gmail/ops.py). One Desktop-app OAuth client from your Google Cloud project (Gmail API on,
# consent screen "In production", otherwise Google expires the token after 7 days). Refresh tokens: run
#   docker compose exec jinnee python3 connectors/gmail/auth.py <name>
# yourself and paste the printed line here. An address that is only an alias in another mailbox: set its MAILBOX instead of a token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCOUNTS=                 # e.g. info,owner
# GMAIL_INFO_ADDRESS=info@example-shop.hu
# GMAIL_INFO_REFRESH_TOKEN=
# GMAIL_INFO_MAILBOX=owner     # ONLY if info@ is an alias inside the owner mailbox (then no token for info)
# GMAIL_OWNER_ADDRESS=
# GMAIL_OWNER_REFRESH_TOKEN=
# --- Forge (builder) ---
# GITHUB_TOKEN=             # fine-grained token for THIS repo only: Contents + Pull requests (read and write). Forge opens pull requests, you merge.
# JINNEE_MODEL=             # model for the agent runs (empty = the Claude CLI default); pick the strongest one for Forge's work
# JINNEE_TIMEOUT=600        # seconds one run may take; 1800 for long build jobs
