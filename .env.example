# Read at startup: by Docker (env_file) and by the programs themselves (core/env.py).
# A variable already set in the environment wins. Restart after editing.
# --- Jinnee core
JINNEE_NAME=Jinnee
JINNEE_LANG=hu             # language Jinnee speaks with the owner (hu, en, de…)
TELEGRAM_BOT_TOKEN=
# Required: your own Telegram user ID (a number, ask @userinfobot). The bot obeys this user only
# and does not start without it.
TELEGRAM_OWNER_ID=
PACKS=general              # e.g. general,ecom
REGISTRY_URL=https://jinnee-os.com/registry/index.json
DASHBOARD_PORT=8080
# Empty = the dashboard answers on this machine only (http://localhost:8080).
# Set a password to open it from another device or behind a domain.
DASHBOARD_PASSWORD=

# --- Connectors (only the ones you use)
BILLINGO_API_KEY=
SZAMLAZZ_AGENT_KEY=
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
GLS_CLIENT_NUMBER=
GLS_USERNAME=
GLS_PASSWORD=
# Gmail: OAuth, the installer walks you through it → connectors/gmail/token.json
