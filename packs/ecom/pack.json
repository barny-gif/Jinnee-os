{
  "id": "ecom",
  "name": "E-commerce team",
  "version": "0.2.0",
  "description": "Online-shop operations: marketing, social, order-to-invoice-to-shipping chain, development.",
  "extends": "general",
  "agents": ["marketing-manager", "social-media-manager", "ops", "forge"],
  "connectors": {
    "required": ["shop"],
    "optional": ["meta-ads", "shipping"],
    "defaults": { "shop": "shopify", "shipping": "gls" },
    "alternatives": {
      "shop": ["shopify", "unas", "shoprenter", "woocommerce"],
      "shipping": ["gls", "foxpost", "packeta"]
    }
  },
  "onboarding": "onboarding.md",
  "autonomy_defaults": {
    "publish_social_post": { "level": 1, "max_level": 2, "locked": true, "label": "Publish a social post" },
    "send_customer_email": { "level": 1, "max_level": 2, "locked": true, "label": "Send an email to a customer" },
    "issue_invoice": { "level": 1, "max_level": 2, "locked": true, "label": "Issue an invoice" },
    "change_product_price": { "level": 0, "max_level": 0, "locked": true, "label": "Change a product price" },
    "spend_ad_budget": { "level": 0, "max_level": 0, "locked": true, "label": "Spend advertising budget" },
    "issue_refund": { "level": 0, "max_level": 0, "locked": true, "label": "Refund a customer" },
    "change_live_shop": { "level": 1, "max_level": 1, "locked": true, "label": "Change the live shop (theme, pages)" },
    "draft_anything": { "level": 3, "label": "Write drafts" },
    "read_anything": { "level": 3, "label": "Read connected systems" }
  }
}
